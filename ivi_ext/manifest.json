{
  "manifest_version": 3,
  "name": "IVI Admin Fill",
  "version": "1.0",
  "description": "Кнопка для автоматического заполнения формы админки IVI",
  "permissions": [],
  "host_permissions": ["http://localhost:8766/"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}
